[Unit]
Description=Raspberry Pi Phone API
After=network-online.target
Wants=network-online.target

[Service]
User=rpiphone
WorkingDirectory=/opt/rpi-phone/server
EnvironmentFile=/opt/rpi-phone/server/config/server.env
ExecStart=/opt/rpi-phone/server/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
